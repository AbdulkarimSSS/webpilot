# ==============================================================================
# Universal Web Applier Environment Configuration Template
# ==============================================================================
# Priority Order:
# 1. Environment variables (os.environ)
# 2. .env file
# 3. Dedicated JSON config files (config/settings.json, config/device_profile.json)
# ==============================================================================

# Application & Engine Settings
APP_HEADLESS=true
APP_DEFAULT_TIMEOUT_MS=45000
APP_FORM_READY_TIMEOUT_MS=10000
APP_SUBMISSION_WAIT_MS=8000
APP_EXPAND_SECTION_WAIT_MS=800
APP_COOKIES_PATH=
APP_DATA_PATH=sample_payload.json
APP_SCREENSHOTS_DIR=screenshots
APP_SETTINGS_PATH=config/settings.json
APP_DEVICE_PROFILE_PATH=config/device_profile.json

# Proxy Configuration (IP / Port / Auth sourced exclusively from config)
APP_PROXY_SERVER=
APP_PROXY_USERNAME=
APP_PROXY_PASSWORD=

# Geolocation Coordinates (Latitude / Longitude / Accuracy sourced exclusively from config)
APP_GEOLOCATION_LATITUDE=
APP_GEOLOCATION_LONGITUDE=
APP_GEOLOCATION_ACCURACY=

# Device Profile Overrides
DEVICE_NAME=
DEVICE_USER_AGENT=
DEVICE_VIEWPORT_WIDTH=
DEVICE_VIEWPORT_HEIGHT=
DEVICE_SCALE_FACTOR=
DEVICE_IS_MOBILE=
DEVICE_HAS_TOUCH=
DEVICE_LOCALE=
DEVICE_TIMEZONE=
DEVICE_PLATFORM=
DEVICE_VENDOR=
